# readvideo resolve 服务环境变量
# 安装后放在 /etc/readvideo/env，权限 640，属主 root:readvideo

# 监听地址（只绑 loopback，由 nginx 反代对外）
RV_HOST=127.0.0.1
RV_PORT=8891

# 总时限（含所有上游请求），毫秒
RV_TOTAL_TIMEOUT_MS=15000
# 单个上游请求时限，毫秒
RV_UPSTREAM_TIMEOUT_MS=6000

# 并发：同时处理 4 个，最多排队 8 个
RV_CONCURRENCY=4
RV_QUEUE_MAX=8

# 限流：每 IP 每分钟 6 次，全局每分钟 60 次
RV_RATE_PER_IP=6
RV_RATE_GLOBAL=60

# 缓存：90 秒（音频直链约 2 小时过期，不能缓存太久）
RV_CACHE_TTL_MS=90000
RV_CACHE_MAX=200

# 熔断：连续 3 次失败 -> 退避 5 分钟
RV_BREAKER_THRESHOLD=3
RV_BREAKER_COOLDOWN_MS=300000

# 请求体上限 8KB
RV_MAX_BODY=8192
# 上游响应体上限 2MB
RV_MAX_UPSTREAM=2000000

# CORS 允许的前端来源（逗号分隔）
RV_CORS_ORIGIN=https://survivorno1.github.io,http://localhost:4186,http://127.0.0.1:4186

# 只信任这些地址传来的 X-Forwarded-For
RV_TRUST_PROXY=127.0.0.1,::1,::ffff:127.0.0.1
